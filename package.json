{
  "name": "itech-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "bootstrap:admin": "node --env-file=.env.local scripts/provision-user.mjs --bootstrap",
    "provision:user": "node --env-file=.env.local scripts/provision-user.mjs",
    "test:rules": "node scripts/test-firestore-rules.mjs"
  },
  "dependencies": {
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "sass": "1.108.2",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
